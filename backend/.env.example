# Local LLM (Ollama) for CV tailoring
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Database
DATABASE_URL=sqlite:///./data/smashapply.db

# CORS
CORS_ORIGINS=http://localhost:3000

# JobSpy live scraping
JOBSPY_SITES=linkedin,indeed,glassdoor,zip_recruiter
